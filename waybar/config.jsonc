{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin": 16,
  "reload_style_on_change": true,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "wireplumber", "network", "cpu", "memory", "temperature"],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%a, %d %B %Y}"
  },

  "network": {
    "format-wifi": "Wifi signal: {signalStrength}%",
    "format-ethernet": "Connected",
    "format-disconnected": "Offline"
  },

  "cpu": {
    "format": "CPU in use: {usage}%"
  },

  "memory": {
    "format": "RAM in use: {used}Gi"
  },

  "tray": {
    "spacing": 10
  },

  "wireplumber": {
    "format": "Volume {volume}%"
  },

  "temperature": {
    "format": "Temperature {temperatureC}°C"
  }
}
